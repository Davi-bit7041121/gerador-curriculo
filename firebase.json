{
  "hosting": {
    "public": ".",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**",
      "**/*.py",
      "**/*.txt",
      "**/*.md",
      "**/*.yml",
      "**/*.yaml",
      "Dockerfile",
      "usuarios.json",
      ".github/**"
    ],
    "rewrites": [
      { "source": "/health", "run": { "serviceId": "curriculo-api", "region": "southamerica-east1" } },
      { "source": "/cadastrar", "run": { "serviceId": "curriculo-api", "region": "southamerica-east1" } },
      { "source": "/login", "run": { "serviceId": "curriculo-api", "region": "southamerica-east1" } },
      { "source": "/gerar_curriculo", "run": { "serviceId": "curriculo-api", "region": "southamerica-east1" } }
    ]
  }
}
